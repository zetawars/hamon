{
  "name": "hamon",
  "productName": "Hamon",
  "version": "1.2.0",
  "description": "Project tracker where every ticket and every link is a markdown file. Web app first, desktop app (Electron) second, plus an MCP server for Claude.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "web": "node src/server.js",
    "start": "electron .",
    "mcp": "node mcp/server.mjs",
    "test": "node test/mcp-test.mjs",
    "dist": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps || node -e \"\"",
    "docs:example": "node scripts/example-project.js",
    "docs:screenshots": "node -e \"process.env.HAMON_HOME='.smoke/docs-home';process.env.HAMON_PROJECTS='examples';process.env.HAMON_THEME='light';process.env.HAMON_SCREENSHOTS='1';require('child_process').spawnSync(require('electron'),['.'],{stdio:'inherit'})\""
  },
  "build": {
    "appId": "local.hamon",
    "productName": "Hamon",
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "d3": "7.9.0",
    "yaml": "2.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": "github:zetawars/hamon",
  "keywords": [
    "project-management",
    "mcp",
    "claude",
    "markdown",
    "ai",
    "game-dev"
  ]
}
